# The GNU-linked gateway binary and the Docker and Podman compute drivers it
# launches as subprocesses are staged at:
#   deploy/docker/.build/prebuilt-binaries/<arch>/openshell-gateway
#   deploy/docker/.build/prebuilt-binaries/<arch>/openshell-driver-docker
#   deploy/docker/.build/prebuilt-binaries/<arch>/openshell-driver-podman
#
# Distroless Debian provides the glibc runtime required by the binary.

ARG GATEWAY_BASE_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:cb87acc574abe719b6e5c547384defa2f7b1f24af9605d3f618cf852495d8be2
FROM ${GATEWAY_BASE_IMAGE} AS gateway

ARG TARGETARCH

WORKDIR /app

COPY deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-gateway /usr/local/bin/openshell-gateway
# /usr/libexec/openshell is one of the directories the gateway searches for drivers.
COPY deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-driver-docker /usr/libexec/openshell/openshell-driver-docker
COPY deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-driver-podman /usr/libexec/openshell/openshell-driver-podman

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
